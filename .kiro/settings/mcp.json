{
  "mcpServers": {
    "rds-mysql-upgrade": {
      "command": "uv",
      "args": [
        "run", "python", "-m", "rds_upgrade_mcp.server"
      ],
      "env": {
        "AWS_DEFAULT_REGION": "us-west-2"
      },
      "disabled": false,
      "autoApprove": [
        "discover_instances",
        "run_precheck",
        "batch_precheck",
        "migrate_params",
        "prepare_param_group",
        "check_option_group",
        "generate_config",
        "create_blue_green",
        "monitor_blue_green",
        "pre_switchover_check",
        "upgrade_green_instance",
        "validate_upgrade",
        "app_validate"
      ]
    }
  }
}
